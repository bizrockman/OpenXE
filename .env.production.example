# Environment variables for the Production OpenXE stack.
#
# These are referenced from docker-compose.yml as ${VARIABLE}.
# When deploying via Coolify, set them in the Coolify UI under
# "Environment Variables" for this application — Coolify will
# auto-detect the references and prompt for values.
#
# When running locally with the override.yml, you can either set
# them as shell env vars before `docker compose up`, or create a
# `.env` file alongside docker-compose.yml (gitignored).

# Database credentials — must NOT be left at defaults in production
MYSQL_ROOT_PASSWORD=change_me_to_a_strong_random_password
MYSQL_USER=openxe
MYSQL_PASSWORD=change_me_to_a_strong_random_password
MYSQL_DATABASE=openxe

# Coolify auto-generates SERVICE_FQDN_APP_80 once you assign a
# domain to the app service in the UI; you don't need to set
# it manually.
