# MariaDB tuning for the OpenXE deployment.
#
# Values are based on the production Xentral installation that has
# been running this database shape for years, with one deviation:
# innodb_buffer_pool_size is raised from 512M to 2G because the
# Coolify host has 8 GB RAM and the database is about 6 GB — more
# cache = fewer disk reads, which was the bottleneck we observed
# (72 % pool hit rate at 128M default, many full-table scans).
#
# Mount into the mariadb container as
# /etc/mysql/conf.d/openxe.cnf (see docker-compose.yml).

[mysqld]

# --- InnoDB: the dominant factor for OpenXE read performance ---
innodb_buffer_pool_size         = 2G
innodb_buffer_pool_instances    = 8
innodb_log_file_size            = 1G
innodb_log_buffer_size          = 10M
innodb_flush_log_at_trx_commit  = 2
innodb_thread_concurrency       = 6
innodb_stats_on_metadata        = OFF
innodb_strict_mode              = 0
innodb_file_per_table           = ON

# --- Per-connection buffers (hit hard by OpenXE's ORDER BY patterns) ---
sort_buffer_size                = 8M
join_buffer_size                = 8M
read_buffer_size                = 2M
read_rnd_buffer_size            = 16M

# --- Temp table sizing (keeps GROUP BY / subqueries out of tmpdir) ---
tmp_table_size                  = 128M
max_heap_table_size             = 128M

# --- MyISAM bits (OpenXE still has MyISAM legacy tables) ---
key_buffer_size                 = 128M
myisam_sort_buffer_size         = 128M
bulk_insert_buffer_size         = 64M

# --- Connections, caches, limits ---
max_connections                 = 512
max_allowed_packet              = 64M
thread_cache_size               = 32
table_open_cache                = 2048
table_definition_cache          = 1024
open_files_limit                = 65535

# --- Charset (ensures connection-level defaults match utf8mb4) ---
character-set-server            = utf8mb4
collation-server                = utf8mb4_general_ci
init-connect                    = 'SET NAMES utf8mb4'

# --- Misc Xentral-era settings kept for compatibility ---
explicit_defaults_for_timestamp = 1
log_bin_trust_function_creators = 1
disable_log_bin
